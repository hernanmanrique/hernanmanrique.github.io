{% comment %}
  Full-bleed homepage hero image slider. Enable on a page by adding to its
  front matter:

  hero_slider:
    enabled: true
    title: Your Name
    subtitle: A short line about you
    cta_text: See my publications
    cta_url: /publications/
    images:
      - src: /assets/img/your-photo.jpg
        alt: Descriptive alt text
        caption: Optional short caption
{% endcomment %}
{% if page.hero_slider and page.hero_slider.enabled and page.hero_slider.images.size > 0 %}
  <div class="hero-slider" role="group" aria-label="Photo slideshow">
    <div class="hero-slides">
      {% for image in page.hero_slider.images %}
        <figure class="hero-slide{% if forloop.first %} active{% endif %}">
          <img src="{{ image.src }}" alt="{{ image.alt }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}" />
          <div class="hero-vignette"></div>
          {% if image.caption %}
            <figcaption class="hero-caption">{{ image.caption }}</figcaption>
          {% endif %}
        </figure>
      {% endfor %}
    </div>

    <div class="hero-overlay"></div>

    {% if page.hero_slider.title or page.hero_slider.subtitle or page.hero_slider.cta_text %}
      <div class="hero-content">
        {% if page.hero_slider.title %}<h1 class="hero-title">{{ page.hero_slider.title }}</h1>{% endif %}
        {% if page.hero_slider.subtitle %}<p class="hero-subtitle">{{ page.hero_slider.subtitle }}</p>{% endif %}
        {% if page.hero_slider.cta_text and page.hero_slider.cta_url %}
          <a class="hero-cta" href="{{ page.hero_slider.cta_url | relative_url }}">{{ page.hero_slider.cta_text }}</a>
        {% endif %}
      </div>
    {% endif %}

    {% if page.hero_slider.images.size > 1 %}
      <button type="button" class="hero-arrow hero-arrow-prev" aria-label="Previous slide">&#10094;</button>
      <button type="button" class="hero-arrow hero-arrow-next" aria-label="Next slide">&#10095;</button>
      <div class="hero-dots">
        {% for image in page.hero_slider.images %}
          <button
            type="button"
            class="hero-dot{% if forloop.first %} active{% endif %}"
            data-slide="{{ forloop.index0 }}"
            aria-label="Show slide {{ forloop.index }}"
          ></button>
        {% endfor %}
      </div>
    {% endif %}
  </div>
{% endif %}
